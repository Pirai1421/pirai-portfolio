# ==========================================
# Pirai Soodan G. Portfolio & AI Assistant
# Environment Variables Configuration
# ==========================================

# --- Google Gemini API Configuration (Server-Side Only) ---
# Provide your Google Gemini API key to activate Live AI generation.
# If left empty, the application runs in Verified Knowledge Base (Demo) Mode
# with strict scope guardrails and curated portfolio facts.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15

# --- Backend Server Configuration ---
SERVER_PORT=8080

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://portfolio-git-master-pirai-soodan-gs-projects.vercel.app

# --- Rate Limiting ---
PORTFOLIO_RATE_LIMIT_PER_MINUTE=30
